{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocab-learning-app",
  "account_id": "b7e9643a4798eb8d75ab6a5a6f73f783",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vocab-learning-app"
    },
    {
      "binding": "API",
      "service": "vocab-api"
    }
  ],
  "vars": {
    // Fallback for the forwarder while the `API` binding above is commented out: the
    // public origin of the deployed api Worker. Overridable per-deploy without a
    // rebuild; ignored entirely once the binding exists.
    "API_ORIGIN": "https://vocab-api.hoshiku1997.workers.dev"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
