{
  "name": "vocab-learning-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "extract:oxford": "tsx scripts/extract-oxford-3000.ts",
    "gen:api-types": "openapi-typescript ${API_ORIGIN:-http://localhost:4000}/openapi.json -o lib/api-types.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cypress": "node cypress/scripts/run-full-stack.mjs",
    "test:e2e:cypress:open": "node cypress/scripts/run-full-stack.mjs --open",
    "test:release": "pnpm test:e2e && pnpm test:e2e:cypress",
    "e2e:seed": "node backend/scripts/generate-e2e-seed.mjs > backend/seed/e2e.sql",
    "check:production-migrations": "node scripts/validate-production-migrations.mjs",
    "test:coverage-audit": "node scripts/check-test-coverage.mjs",
    "test:all": "pnpm check:production-migrations && pnpm test:coverage-audit && pnpm exec tsc --noEmit && pnpm test:release"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.2.11",
    "next-intl": "^4.12.0",
    "notistack": "^3.0.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^15.19.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "openapi-typescript": "^7.13.0",
    "pdf-parse": "1.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.86.0"
  }
}
